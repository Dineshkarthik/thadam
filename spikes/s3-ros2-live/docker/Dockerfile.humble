# Spike S3 (ADR-0007 step 3, best effort): ROS 2 Humble + Fast DDS reached
# through zenoh-bridge-ros2dds. Humble's rmw_zenoh is zenoh-0.11 based and
# incompatible with a zenoh 1.x client (ADR-0007 note), so Humble is run only
# through the DDS bridge.
#
#   docker build -f docker/Dockerfile.humble -t s3-ros2-zenoh:humble-1 .
#
# Base pinned by digest (Docker Hub, amd64+arm64 both published):
#   ros:humble-ros-base, pulled 2026-10-12, Ubuntu 22.04 "jammy".
FROM ros:humble-ros-base@sha256:860e53793ccf575e5369b5e9a19939de2bfcfb46a299954d06f54f2af54fed19

# Opt-in TLS-intercepting-proxy hook (same pattern as docker/Dockerfile).
COPY docker/secrets/ /tmp/s3-secrets/
RUN set -e; \
    if [ -f /tmp/s3-secrets/ca.pem ]; then \
        cp /tmp/s3-secrets/ca.pem /usr/local/share/ca-certificates/s3-ca.crt; \
        update-ca-certificates; \
    fi

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ros-humble-tf2-msgs \
        python3 \
    && rm -rf /var/lib/apt/lists/*

COPY docker/sensor_pub.py /usr/local/lib/s3/sensor_pub.py
COPY docker/default_rmw.py /usr/local/lib/s3/default_rmw.py

RUN dpkg-query -W -f='${Package} ${Version}\n' \
        ros-humble-rmw-fastrtps-cpp ros-humble-fastrtps \
        > /usr/local/lib/s3/versions.txt \
    && echo "default RMW: $(bash -c '. /opt/ros/humble/setup.bash && python3 /usr/local/lib/s3/default_rmw.py')" \
        >> /usr/local/lib/s3/versions.txt
